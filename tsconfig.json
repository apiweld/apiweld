{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@apiweld/core": ["./packages/core/src/index.ts"],
      "@apiweld/core/*": ["./packages/core/src/*"],
      "@apiweld/cli": ["./packages/cli/src/main.ts"],
      "@apiweld/mcp": ["./packages/mcp/src/server.ts"],
      "@apiweld/gen-heyapi": ["./packages/gen-heyapi/src/index.ts"],
      "@apiweld/gen-oapi": ["./packages/gen-oapi/src/index.ts"],
      "apiweld": ["./packages/apiweld/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "tests/**/*.ts",
    "catalog/build/**/*.ts"
  ]
}
