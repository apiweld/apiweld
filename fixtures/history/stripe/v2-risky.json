{
  "openapi": "3.0.3",
  "info": {
    "title": "Stripe API",
    "version": "2026-09-03",
    "description": "Payments infrastructure. Create a refund for a charge."
  },
  "servers": [
    {
      "url": "https://api.stripe.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "secret key"
      }
    },
    "schemas": {
      "Refund": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the refund"
          },
          "amount": {
            "type": "integer",
            "description": "Amount in minor units"
          },
          "charge": {
            "type": "string"
          },
          "payment_intent": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "duplicate",
              "fraudulent",
              "requested_by_customer"
            ]
          },
          "status": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "failure_balance_transaction": {
            "type": "string",
            "description": "Balance transaction that describes the reversal"
          }
        },
        "required": [
          "id",
          "amount",
          "status",
          "failure_balance_transaction"
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "legacy_card": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "legacy_card"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/refunds": {
      "post": {
        "operationId": "createRefund",
        "summary": "Create a refund",
        "description": "Refund a payment by charge or payment intent.",
        "tags": [
          "Refunds"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "charge": {
                    "type": "string",
                    "description": "ID of the charge to refund"
                  },
                  "payment_intent": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "integer",
                    "description": "minor units; defaults to full amount"
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "duplicate",
                      "fraudulent",
                      "requested_by_customer"
                    ]
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The refund",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refund"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "402": {
            "description": "Request failed"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/v1/refunds/{refund}": {
      "get": {
        "operationId": "getRefund",
        "summary": "Retrieve a refund",
        "description": "Retrieves the details of an existing refund.",
        "tags": [
          "Refunds"
        ],
        "parameters": [
          {
            "name": "refund",
            "in": "path",
            "required": true,
            "description": "Refund id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The refund",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refund"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/v1/customers": {
      "post": {
        "operationId": "createCustomer",
        "summary": "Create a customer",
        "description": "Creates a customer object.",
        "tags": [
          "Customers"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The customer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          }
        }
      }
    }
  }
}
