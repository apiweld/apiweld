{
  "openapi": "3.0.3",
  "info": {
    "title": "Pets API",
    "version": "1.0.0",
    "description": "List and adopt pets."
  },
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List pets",
        "description": "Returns pets available for adoption.",
        "tags": [
          "Pets"
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
