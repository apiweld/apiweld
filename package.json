{
  "name": "apiweld-workspace",
  "private": true,
  "type": "module",
  "version": "0.4.0",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "engine:build": "go build -C engine -o bin/apiweld-engine ./cmd/apiweld-engine",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:engine": "go test -C engine ./...",
    "apiweld": "node packages/apiweld/bin/apiweld.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "zod": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
